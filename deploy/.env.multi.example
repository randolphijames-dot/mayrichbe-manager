# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Social Manager - Multi-tenant Environment Variables
#  Copy to .env.multi and fill in real values:
#    cp .env.multi.example .env.multi
#
#  manage-users.sh will auto-append new users here
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# --- user01 ---
USER01_SECRET_KEY=change-me-to-random-string
USER01_ACCESS_PASSWORD=change-me

# --- user02 ---
USER02_SECRET_KEY=change-me-to-random-string
USER02_ACCESS_PASSWORD=change-me

# --- user03 ---
USER03_SECRET_KEY=change-me-to-random-string
USER03_ACCESS_PASSWORD=change-me

# New users added by manage-users.sh will be appended below
